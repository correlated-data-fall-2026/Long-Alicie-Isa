knitr::opts_chunk$set(echo = TRUE, error=TRUE)
library(tidyverse)
library(tidyverse)
source("cleaning_active.R")
memory_data <- activeLong %>%
filter(INTGRP %in% c("Memory Training", "Control")) %>%
droplevels() %>%
mutate(INTGRP = relevel(INTGRP, ref = "Control"))
Memory ~ factor(Years) * INTGRP + AgeAtBaseline
#source('cleaning_active.R') # Open Cleaning.R to see the data cleaning steps to create a long format dataset
library(geeM)
#library(lme4)
library(tidyr)
memory_data <- memory_data %>%
drop_na(Memory, Years, INTGRP, AgeAtBaseline) %>%
arrange(AID, Years)
gee_mod1 <- memory_data %>%
geem(Memory ~ factor(Years) * INTGRP + AgeAtBaseline, data = ., id = AID, corstr = "independence")
summary(gee_mod1)
gee_mod2 <- memory_data %>%
geem(Memory ~ factor(Years) * INTGRP + AgeAtBaseline, data = ., id = AID, corstr = "exchangeable")
summary(gee_mod2)
#gee_mod1 %>% summary()
#lmer_mod1 %>% summary()
# Residuals = Obs - Predicted
data %>%
mutate(Pred = predict(mod, newdata = .)) %>% #replace mod with your chosen model
mutate(Resid = y - Pred) %>% #replace y with your outcome
ggplot(aes(x = Pred, y = Resid)) +  # you can replace Pred with a quantitative x
geom_point(alpha = .2) +
geom_hline(yintercept = 0) +
geom_smooth(se = FALSE) +
theme_classic()
